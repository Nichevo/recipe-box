# Copy to .env (git-ignored) for local scripts such as the Notion import.
# Production secrets are set in Cloudflare (wrangler secret put) and GitHub
# Actions secrets, never committed. See docs/SETUP.md.

# AI
ANTHROPIC_API_KEY=
OLLAMA_URL=
OLLAMA_ACCESS_CLIENT_ID=
OLLAMA_ACCESS_CLIENT_SECRET=

# Cloudflare Access (production API check)
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Grocery sync (Google Sheets API, service account JSON)
GROCERY_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Notion import (local script only)
NOTION_TOKEN=
NOTION_ROOT_PAGE_ID=

# Dropbox backup
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
