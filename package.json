{
  "name": "recipe-box",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted family recipe manager: a PWA plus a Cloudflare Worker API.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "privacy-check": "node scripts/privacy-check.mjs",
    "render-config": "node scripts/render-wrangler-config.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "hono": "^4.13.19",
    "jose": "^6.2.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
